# AWS Bedrock Configuration (Claude - primary AI provider)
# Uses Lambda IAM role for auth - no API key needed
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0  # default: Sonnet 4.5

# Buffer API Configuration (cross-platform social media posting)
BUFFER_ACCESS_TOKEN=your-buffer-access-token

# OpenAI API Configuration (legacy/optional - kept for DALL-E image generation)
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_CHAT_MODEL=gpt-4o-mini   # default: gpt-4o-mini (cheap), use gpt-4o for production
# OPENAI_IMAGE_MODEL=dall-e-2    # default: dall-e-2 (cheap), use dall-e-3 for production

# GitHub Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret

# LinkedIn API Configuration (legacy - use Buffer instead)
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_ACCESS_TOKEN=your-access-token-here

# Application Configuration
PORT=8080
LOG_LEVEL=info
